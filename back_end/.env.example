# Copie este arquivo para ".env" e preencha com os dados do seu PostgreSQL.

# Porta em que a API (e o front-end) ficarão disponíveis
PORT=3000

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres
DB_NAME=intellistock_web

# Segredo usado para assinar os tokens de login (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
