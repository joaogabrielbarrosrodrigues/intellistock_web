# Copie este arquivo para .env dentro de back_end/.
# Nunca faça commit do arquivo .env ou de senhas reais.
PORT=3000

# mock = teste independente de banco / postgres = dados reais
DASHBOARD_DATA_SOURCE=mock

# Usado somente quando DASHBOARD_DATA_SOURCE=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intellistock_web
DB_USER=postgres
DB_PASSWORD=coloque_sua_senha_aqui
DB_SSL=false
